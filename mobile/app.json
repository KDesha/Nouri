{
  "expo": {
    "name": "Nouri",
    "slug": "nouri",
    "scheme": "nouri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/nouri-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kayladeshasier.nouri",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kayladeshasier.nouri",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/nouri-icon.png",
        "backgroundColor": "#FFF8EA"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/nouri-icon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EA",
          "image": "./assets/nouri-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ]
  }
}
