PORT=4000
DATABASE_URL=postgresql://username:password@host:5432/nouri?sslmode=verify-full
FDC_API_KEY=replace_with_usda_fooddata_central_key
# Optional Edamam Food Database trial. Leave disabled until both values are set.
EDAMAM_TRIAL_ENABLED=false
EDAMAM_APP_ID=replace_with_edamam_food_app_id
EDAMAM_APP_KEY=replace_with_edamam_food_app_key
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development
